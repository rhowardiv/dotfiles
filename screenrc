#setenv LC_CTYPE en_US.UTF-8
#defutf8 on

sorendition gK

startup_message off
defscrollback 10000

# a nice status line
# get_freemem is:
# free -h | grep ^Mem | awk '{print $7}'
backtick 1 60 60 $HOME/bin/get_freemem
# netwatchd is:
# F='(.rx.packetspersecond|tostring)+"r"+'
# F="${F}(.tx.packetspersecond|tostring)+\"t\""
# stdbuf -oL -eL vnstat --live 0 --style 4 --json \
# | stdbuf -oL -eL jq -r "$F" \
# > /tmp/netwatchd
backtick 3 3 3 tail -n 1 /tmp/netwatchd
# topproc is:
# top -b -n 1 -o %CPU |
# awk 'NR>7 && $9+0 > 10.0 && $12 != "top" {print $9, $12}' |
# head -n 1`
backtick 5 3 3 $HOME/bin/topproc
backtick 7 3 3 bash -c 'tail -n 5 /tmp/iowatchd | asciispark'
hardstatus on
hardstatus alwayslastline 
hardstatus string '%{#32CD32;#000000}[%{#87CEEB;#000000}%H%{#32CD32;#000000}][ %{#AAAAAA;#000000}%?%-Lw%?%{#000000;#EEEEEE} %n*%f%t%?(%u)%? %{#AAAAAA;#000000}%?%+Lw%?%= %{#32CD32;#000000}][%{#87CEEB;#000000}%?%5` %?%?%3` %?%1` %7`%{#32CD32;#000}]'

# visual bell is like shocking coworkers with lightning
vbell off

# starting windows
chdir $HOME
screen -t home

truecolor on
# erase background with current bg color
defbce on 

# use 's' for 'split' instead of XOFF (XOFF!? yikes!)
bind s split
